{
  "name": "portfolio-tracker",
  "version": "0.1.0",
  "description": "자동으로 프로젝트 진도를 추적하고 대시보드를 제공하는 도구",
  "main": "dist/cli/index.js",
  "bin": {
    "portfolio-tracker": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/cli/index.ts",
    "build": "tsc && chmod +x dist/cli/index.js",
    "prepack": "npm run build",
    "start": "node dist/cli/index.js",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "format": "prettier --write \"src/**/*.ts\"",
    "lint": "eslint src --ext .ts"
  },
  "keywords": [
    "portfolio",
    "project-tracker",
    "progress",
    "dashboard"
  ],
  "author": "jean325",
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.3.0",
    "cli-table3": "^0.6.3",
    "commander": "^12.1.0",
    "glob": "^11.0.0",
    "inquirer": "^13.4.2",
    "simple-git": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^20.12.12",
    "@typescript-eslint/eslint-plugin": "^8.59.1",
    "@typescript-eslint/parser": "^8.59.1",
    "eslint": "^9.3.0",
    "prettier": "^3.2.5",
    "tsx": "^4.7.0",
    "typescript": "^5.4.5",
    "vitest": "^4.1.5"
  }
}
